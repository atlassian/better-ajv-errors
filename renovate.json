{
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "replace",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchPackageNames": [
        "node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
