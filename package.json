{
  "name": "better-ajv-errors",
  "version": "2.0.4",
  "description": "JSON Schema validation for Human",
  "repository": "atlassian/better-ajv-errors",
  "main": "./lib/index.cjs",
  "types": "./typings.d.cts",
  "type": "module",
  "exports": {
    "require": {
      "types": "./typings.d.cts",
      "default": "./lib/index.cjs"
    },
    "import": {
      "types": "./typings.d.mts",
      "default": "./lib/index.js"
    }
  },
  "module": "./lib/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">= 22"
  },
  "keywords": [
    "json-schema",
    "ajv",
    "ajv-errors"
  ],
  "author": "Rifat Nabi <to.rifat@gmail.com>",
  "maintainers": [
    "Rifat Nabi <to.rifat@gmail.com>",
    "Dmitrii Sorin <info@staypositive.ru>",
    "Tong Li"
  ],
  "license": "Apache-2.0",
  "files": [
    "lib",
    "typings.d.mts",
    "typings.d.cts"
  ],
  "scripts": {
    "prebuild": "rm -rf lib",
    "build": "node build.js",
    "prerelease": "npm run build",
    "release": "changeset publish",
    "release:atlassian": "node publish-atlassian.js",
    "format": "vp fmt './src/**/*.js' './.changeset/*.json'",
    "format:check": "vp fmt --check './src/**/*.js' './.changeset/*.json'",
    "prelint": "npm run build",
    "lint": "vp lint && publint",
    "lint:actions": "actionlint && zizmor .github/workflows",
    "test": "vp test",
    "test-ci": "vp test --coverage",
    "prescreenshot": "npm run build",
    "screenshot": "svg-term --command='node screenshot' --out=./media/screenshot.svg --padding=5 --width=80 --height=13 --at=1000 --no-cursor --term iterm2 --profile='deep' --window",
    "prepare": "is-ci || vp config"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "@humanwhocodes/momoa": "^3.3.13",
    "jsonpointer": "^5.0.1",
    "leven": "^3.1.0 < 4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "is-ci": "^4.1.0",
    "jest-fixtures": "^0.6.0",
    "publint": "^0.3.25",
    "svg-term-cli": "^2.1.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "ajv": "4.11.8 - 8"
  }
}
