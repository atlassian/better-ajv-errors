{
  "name": "better-ajv-errors",
  "version": "3.0.3",
  "description": "JSON Schema validation for Human",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlassian/better-ajv-errors.git"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "type": "module",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "engines": {
    "node": ">= 24"
  },
  "packageManager": "pnpm@12.15.0",
  "keywords": [
    "json-schema",
    "ajv",
    "ajv-errors"
  ],
  "author": "Rifat Nabi <to.rifat@gmail.com>",
  "maintainers": [
    "Rifat Nabi <to.rifat@gmail.com>",
    "Dmitrii Sorin <info@staypositive.ru>",
    "Tong Li"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "prerelease": "npm run build",
    "release": "pnpm publish",
    "release:atlassian": "node publish-atlassian.js",
    "format": "vp fmt './src/**/*.ts'",
    "format:check": "vp fmt --check './src/**/*.ts'",
    "prelint": "npm run build",
    "lint": "vp lint && publint",
    "lint:actions": "actionlint && zizmor .github/workflows",
    "test": "vp test",
    "test-ci": "vp test --coverage",
    "prescreenshot": "npm run build",
    "screenshot": "FORCE_COLOR=1 node screenshot | svg-term --out=./media/screenshot.svg --padding=5 --width=80 --height=13 --at=1000 --no-cursor --term xresources --profile=./media/deep.Xresources --window",
    "prepare": "is-ci || vp config"
  },
  "dependencies": {
    "@humanwhocodes/momoa": "^3.3.13",
    "jsonpointer": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "ajv": "^8.20.0",
    "is-ci": "^4.1.0",
    "publint": "^0.3.25",
    "svg-term-cli": "^2.1.1",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "ajv": "4.11.8 - 8"
  }
}
